{
  "name": "bruff",
  "version": "0.0.0",
  "private": true,
  "description": "A modern JavaScript/TypeScript roguelike game collection with focus on functional programming patterns and type safety.",
  "keywords": [
    "broughlike",
    "roguelike"
  ],
  "license": "BSD-3-Clause",
  "author": "Duncan Kolba <duncankolba@gmail.com>",
  "contributors": [
    {
      "name": "Duncan Kolba",
      "email": "duncankolba@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkolba/bruff.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "changeset:add": "changeset",
    "changeset:version": "changeset version",
    "cli": "pnpm --filter @bruff/cli run cli",
    "format": "pnpm run format:ai && pnpm -r --parallel run format",
    "format:ai": "prettier -w .agents AGENTS.md",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint:fix",
    "ok": "node scripts/ok.js",
    "start": "pnpm --filter @bruff/arcade run dev",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r --parallel run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
